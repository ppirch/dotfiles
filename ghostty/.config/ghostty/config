# ~/.config/ghostty/config — managed by dotfiles (ghostty/ package, GNU Stow).
# See `ghostty +list-fonts`, `ghostty +list-themes` and https://ghostty.org/docs/config

# Catppuccin Macchiato via the official port (themes/catppuccin-macchiato
# is fetched by scripts/install-ghostty.sh and shadows the built-in
# theme of the same name).
theme = catppuccin-macchiato

font-family = "JetBrainsMono Nerd Font"
